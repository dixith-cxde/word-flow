[Unit]
Description=Offline voice dictation daemon (voxd)
After=pipewire.service
Wants=pipewire.service

[Service]
Type=simple
# Adjust the path below to your checkout, then:
#   mkdir -p ~/.config/systemd/user
#   cp systemd/voxd.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now voxd.service
ExecStart=%h/.local/bin/voxd
Restart=on-failure
RestartSec=2
# The daemon itself idles at ~12 MB / 0% CPU; the model worker exits on timeout.

[Install]
WantedBy=default.target
